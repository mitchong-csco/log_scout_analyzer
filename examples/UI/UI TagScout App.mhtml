@-webkit-keyframes blink {=20
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

@-webkit-keyframes blowup {=20
  0% { transform: scale(0); }
  100% { transform: scale(1); }
}

@-webkit-keyframes bounce {=20
  0%, 20%, 40%, 60%, 80%, 100% { transition-timing-function: cubic-bezier(0=
.215, 0.61, 0.355, 1); }
  0% { transform: scale3d(0.3, 0.3, 0.3); }
  20% { transform: scale3d(1.1, 1.1, 1.1); }
  40% { transform: scale3d(0.9, 0.9, 0.9); }
  60% { transform: scale3d(1.03, 1.03, 1.03); }
  80% { transform: scale3d(0.97, 0.97, 0.97); }
  100% { transform: scaleZ(1); }
}

@-webkit-keyframes load {=20
  0% { transform: rotate(7deg); }
  100% { transform: rotate(360deg); }
}

@-webkit-keyframes pop {=20
  0% { transform: scale3d(0.9, 0.9, 0.9); }
  33% { transform: scale3d(1.05, 1.05, 1.05); }
  66% { transform: scale3d(0.95, 0.95, 0.95); }
  100% { transform: scaleZ(1); }
}

@-webkit-keyframes pulse {=20
  0%, 80%, 100% { transform: scale3d(0, 0, 0); }
  40% { transform: scaleZ(1); }
}

@-webkit-keyframes pulseShadow {=20
  0% { box-shadow: rgba(88, 88, 91, 0.5) 0px 0px; }
  70% { box-shadow: rgba(88, 88, 91, 0) 0px 0px 0px 10px; }
  100% { box-shadow: rgba(88, 88, 91, 0) 0px 0px; }
}

@-webkit-keyframes pulseShadowInfo {=20
  0% { box-shadow: rgba(1, 124, 173, 0.5) 0px 0px; }
  70% { box-shadow: rgba(1, 124, 173, 0) 0px 0px 0px 10px; }
  100% { box-shadow: rgba(1, 124, 173, 0) 0px 0px; }
}

@-webkit-keyframes pulseShadowSuccess {=20
  0% { box-shadow: rgba(110, 190, 74, 0.5) 0px 0px; }
  70% { box-shadow: rgba(110, 190, 74, 0) 0px 0px 0px 10px; }
  100% { box-shadow: rgba(110, 190, 74, 0) 0px 0px; }
}

@-webkit-keyframes pulseShadowWarning {=20
  0% { box-shadow: rgba(251, 171, 24, 0.5) 0px 0px; }
  70% { box-shadow: rgba(251, 171, 24, 0) 0px 0px 0px 10px; }
  100% { box-shadow: rgba(251, 171, 24, 0) 0px 0px; }
}

@-webkit-keyframes pulseShadowDanger {=20
  0% { box-shadow: rgba(226, 35, 26, 0.5) 0px 0px; }
  70% { box-shadow: rgba(226, 35, 26, 0) 0px 0px 0px 10px; }
  100% { box-shadow: rgba(226, 35, 26, 0) 0px 0px; }
}

@-webkit-keyframes spin {=20
  0% { transform: rotate(0deg); }
  100% { transform: rotate(359deg); }
}

@-webkit-keyframes fade-in {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@-webkit-keyframes slideInLeftSmall {=20
  0% { opacity: 0; transform: translate3d(-50%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@-webkit-keyframes slideInLeft {=20
  0% { opacity: 0; transform: translate3d(-100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@-webkit-keyframes slideInRightSmall {=20
  0% { opacity: 0; transform: translate3d(50%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@-webkit-keyframes slideInRight {=20
  0% { opacity: 0; transform: translate3d(100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@-webkit-keyframes slideInUpSmall {=20
  0% { opacity: 0; transform: translate3d(0px, 50%, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@-webkit-keyframes slideInUp {=20
  0% { opacity: 0; transform: translate3d(0px, 100%, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

