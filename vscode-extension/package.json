            },
            {
                "command": "logScoutAnalyzer.sortBySeverity",
                "title": "Scout: Sort by Severity",
                "icon": "$(symbol-color)"
            },
            {
                "command": "logScoutAnalyzer.sortByTime",
                "title": "Scout: Sort by Time",
                "icon": "$(history)"
            },
            {
                "command": "logScoutAnalyzer.sortByFile",
                "title": "Scout: Sort by File",
                "icon": "$(file)"
            },
            {
                "command": "logScoutAnalyzer.sortByCategory",
                "title": "Scout: Sort by Category",
                "icon": "$(symbol-folder)"
            },
            {
                "command": "logScoutAnalyzer.toggleCategory",
