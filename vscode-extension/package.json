                {
                    "command": "logScoutAnalyzer.sortByFile",
                    "when": "view == scoutResults",
                    "group": "2_sorting@4"
                },
                {
                    "command": "logScoutAnalyzer.sortByCategory",
                    "when": "view == scoutResults",
                    "group": "2_sorting@5"
                },
                {
                    "command": "logScoutAnalyzer.exportResults",
                    "when": "view == scoutResults || view == scoutCategories",
                    "group": "navigation"
                },
                {
                    "command": "logScoutAnalyzer.showConsole",
                    "when": "view == scoutResults || view == scoutCategories",
                    "group": "navigation"
                },
                {
                    "command": "logScoutAnalyzer.clearCache",
                    "when": "view == scoutCachedFiles",
                    "group": "navigation"
                },
                {
                    "command": "logScoutAnalyzer.viewCacheMetadata",
                    "when": "view == scoutCachedFiles",
                    "group": "1_metadata@1"
                },
                {
                    "command": "logScoutAnalyzer.bundle.create",
                    "when": "view == scoutBundles",
                    "group": "navigation@1"
                },
                {
                    "command": "logScoutAnalyzer.bundle.importPackage",
                    "when": "view == scoutBundles",
                    "group": "navigation@2"
                }
            ],
            "view/item/context": [
                {
                    "command": "logScoutAnalyzer.patterns.editOverride",
                    "when": "view == scoutPatternOverrides && viewItem == patternItem",
                    "group": "inline@1"
                },
                {
                    "command": "logScoutAnalyzer.patterns.togglePattern",
                    "when": "view == scoutPatternOverrides && viewItem == patternItem",
                    "group": "inline@2"
                },
                {
                    "command": "logScoutAnalyzer.patterns.deleteOverride",
                    "when": "view == scoutPatternOverrides && viewItem == patternItem",
                    "group": "destructive"
                },
                {
                    "command": "logScoutAnalyzer.jumpToLine",
                    "when": "viewItem == result",
                    "group": "1_navigation@1"
                },
                {
                    "command": "logScoutAnalyzer.showPatternForResult",
                    "when": "viewItem == result",
                    "group": "1_navigation@2"
                },
                {
                    "command": "logScoutAnalyzer.copyResultInfo",
                    "when": "viewItem == result",
                    "group": "2_copy@1"
                },
                {
                    "command": "logScoutAnalyzer.bundle.analyze",
                    "when": "view == scoutBundles && viewItem == bundle",
                    "group": "inline@1"
                },
                {
                    "command": "logScoutAnalyzer.bundle.openInQCSOne",
                    "when": "view == scoutBundles && viewItem == bundle",
                    "group": "1_modify@2"
                },
                {
                    "command": "logScoutAnalyzer.bundle.delete",
                    "when": "view == scoutBundles && viewItem == bundle",
                    "group": "2_destructive@1"
                },
                {
                    "command": "logScoutAnalyzer.jumpToLine",
                    "when": "viewItem == result",
                    "group": "1_navigation@1"
                },
                {
                    "command": "logScoutAnalyzer.showPatternForResult",
                    "when": "viewItem == result",
                    "group": "1_navigation@2"
                },
                {
                    "command": "logScoutAnalyzer.copyResultInfo",
                    "when": "viewItem == result",
                    "group": "2_copy@1"
                },
                {
                    "command": "logScoutAnalyzer.showCacheData",
                    "when": "viewItem == result",
                    "group": "3_analysis@1"
                },
                {
                    "command": "logScoutAnalyzer.openCachedFile",
                    "when": "viewItem == cachedFile",
                    "group": "1_open@1"
                },
                {
                    "command": "logScoutAnalyzer.openFileInEditor",
                    "when": "viewItem == cachedFile",
                    "group": "1_open@2"
                },
                {
                    "command": "logScoutAnalyzer.revealInExplorer",
                    "when": "viewItem == cachedFile",
                    "group": "2_explorer@1"
                },
                {
                    "command": "logScoutAnalyzer.removeCachedFile",
                    "when": "viewItem == cachedFile",
                    "group": "3_remove@1"
                },
                {
                    "command": "logScoutAnalyzer.copyFilePath",
                    "when": "viewItem == currentFile",
                    "group": "1_actions@1"
                },
                {
                    "command": "logScoutAnalyzer.openInNewWindow",
                    "when": "viewItem == currentFile",
                    "group": "1_actions@2"
                },
                {
                    "command": "logScoutAnalyzer.showAbout",
                    "when": "viewItem == version",
                    "group": "1_actions@1"
                },
                {
                    "command": "logScoutAnalyzer.copyVersionInfo",
                    "when": "viewItem == version",
                    "group": "2_copy@1"
                }
            ],
            "explorer/context": [
                {
                    "command": "logScoutAnalyzer.bundle.addToBundle",
                    "when": "!explorerResourceIsRoot",
                    "group": "scout@1"
                }
            ],
            "editor/context": [
                {
                    "command": "logScoutAnalyzer.patterns.createOverrideFromSelection",
                    "when": "editorLangId == log && editorHasSelection",
                    "group": "scout@1"
                },
                {
                    "command": "logScoutAnalyzer.patterns.createOverrideFromDiagnostic",
                    "when": "editorLangId == log",
                    "group": "scout@2"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build:lsp && npm run package-extension",
        "update:versions": "node update-versions.js",
        "build": "npm run update:versions && node generate-build-info.js && npm run package-extension",
        "package-extension": "webpack --mode production --devtool hidden-source-map",
        "webpack": "webpack --mode development",
        "webpack-dev": "webpack --mode development --watch",
        "build:lsp": "cd .. && cargo build --release --manifest-path lsp-server/Cargo.toml && node -e \"const crypto=require('crypto'),fs=require('fs'),path=require('path');const src=path.join('target','release','log-scout-lsp-server.exe');const dest=path.join('vscode-extension','bin','log-scout-lsp-server.exe');fs.mkdirSync(path.dirname(dest),{recursive:true});fs.copyFileSync(src,dest);const stats=fs.statSync(dest);const hash=crypto.createHash('sha256').update(fs.readFileSync(dest)).digest('hex');const hashShort=hash.substring(0,16);if(stats.size<5000000){console.error('❌ ERROR: Binary too small ('+Math.round(stats.size/1024/1024)+'MB). Wrong package built!');process.exit(1);}console.log('✅ LSP binary copied to:',dest);console.log('   Size: '+(Math.round(stats.size/1024/1024))+'MB');console.log('   SHA256: '+hashShort+'...');\"",
        "build:lsp:win": "cd .. && cargo build --release --target x86_64-pc-windows-msvc --manifest-path lsp-server/Cargo.toml && node -e \"const crypto=require('crypto'),fs=require('fs'),path=require('path');const src=path.join('target','x86_64-pc-windows-msvc','release','log-scout-lsp-server.exe');const dest=path.join('vscode-extension','bin','log-scout-lsp-server.exe');fs.mkdirSync(path.dirname(dest),{recursive:true});fs.copyFileSync(src,dest);const stats=fs.statSync(dest);const hash=crypto.createHash('sha256').update(fs.readFileSync(dest)).digest('hex');const hashShort=hash.substring(0,16);if(stats.size<5000000){console.error('❌ ERROR: Binary too small ('+Math.round(stats.size/1024/1024)+'MB). Wrong package built!');process.exit(1);}console.log('✅ Windows LSP binary copied to:',dest);console.log('   Size: '+(Math.round(stats.size/1024/1024))+'MB');console.log('   SHA256: '+hashShort+'...');\"",
        "build:all": "npm run version:increment && npm run build:lsp && npm run build",
        "check": "npm run check:lsp && npm run compile",
        "check:lsp": "cd ../lsp-server && cargo check",
        "check:lsp:release": "cd ../lsp-server && cargo check --release",
        "compile": "tsc -p ./ --noEmitOnError false || echo TypeScript warnings present && tsc -p tsconfig.webview.json --noEmitOnError false || echo TypeScript warnings present",
        "compile-tests": "tsc -p ./ --noEmitOnError false",
        "preinstall": "if not exist logs mkdir logs",
        "watch": "tsc -watch -p ./",
        "watch:test": "npm run test:wiring:watch",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js",
        "test:scripts": "node test-scripts.js 2>&1 | tee logs/test-scripts.log",
        "test:wiring": "node run-wiring-tests.js 2>&1 | tee logs/test-wiring.log",
        "test:add-current-file": "node run-add-current-file-tests.js 2>&1 | tee logs/test-add-current-file.log",
        "test:wiring:watch": "nodemon --watch src --ext ts --exec \"npm run compile && npm run test:wiring\"",
        "test:changed": "node scripts/test-changed.js 2>&1 | tee logs/test-changed.log",
        "test:all": "npm run test:wiring && npm test 2>&1 | tee logs/test-all.log",
        "test:security": "mocha src/test/suite/security.test.ts --require ts-node/register 2>&1 | tee logs/test-security.log",
        "test:performance": "mocha src/test/suite/performance.test.ts --require ts-node/register --timeout 10000 2>&1 | tee logs/test-performance.log",
        "test:integration": "mocha src/test/suite/integration.test.ts --require ts-node/register --timeout 5000 2>&1 | tee logs/test-integration.log",
        "test:compatibility": "mocha src/test/suite/compatibility.test.ts --require ts-node/register 2>&1 | tee logs/test-compatibility.log",
        "test:e2e": "mocha src/test/suite/e2e.test.ts --require ts-node/register --timeout 30000 2>&1 | tee logs/test-e2e.log",
        "test:watch": "mocha src/test/suite/**/*.test.ts --require ts-node/register --watch --watch-extensions ts",
        "test:coverage": "nyc --reporter=html --reporter=text npm run test:all 2>&1 | tee logs/test-coverage.log",
        "test:coverage-report": "npm run test:coverage && start coverage/index.html",
        "test:mutation": "stryker run 2>&1 | tee logs/test-mutation.log",
        "test:flake-check": "node scripts/flake-detector.js 2>&1 | tee logs/test-flake-check.log",
        "test:validate-fixtures": "node scripts/validate-fixtures.js 2>&1 | tee logs/test-validate-fixtures.log",
        "test:generate-fixtures": "node scripts/generate-fixtures.js 2>&1 | tee logs/test-generate-fixtures.log",
        "test:ci": "npm run test:all && npm run test:coverage 2>&1 | tee logs/test-ci.log",
        "verify": "npm run test:wiring",
        "dry-run": "node dry-run.js",
        "clean": "node clean.js",
        "help": "node help.js",
        "status": "node show-status.js",
        "version:increment": "node increment-version.js",
        "package": "npm run build:all && vsce package --allow-star-activation",
        "package:only": "vsce package --allow-star-activation",
        "postpackage": "node copy-vsix.js",
        "vs:install": "code --install-extension log-scout-analyzer.vsix",
        "deploy": "npm run package:only && npm run vs:install",
        "dev:setup": "npm install && npm run compile 2>&1 | tee logs/dev-setup.log",
        "dev:reset": "npm run maintain:clean && npm run dev:setup 2>&1 | tee logs/dev-reset.log",
        "dev:test-fast": "npm run test:wiring 2>&1 | tee logs/dev-test-fast.log",
        "dev:test-full": "npm run test:all && npm run security:check-all 2>&1 | tee logs/dev-test-full.log",
        "dev:pre-commit": "npm run compile && npm run test:changed && npm run docs:validate 2>&1 | tee logs/dev-pre-commit.log",
        "dev:verify": "npm run compile && npm run test:all && npm run security:check-all 2>&1 | tee logs/dev-verify.log",
        "dev:watch": "concurrently \"npm run watch\" \"npm run test:watch\"",
        "security:audit": "npm audit --audit-level=moderate 2>&1 | tee logs/security-audit.log",
        "security:audit-fix": "npm audit fix 2>&1 | tee logs/security-audit-fix.log",
        "security:scan": "retire --path src --outputformat json 2>&1 | tee logs/security-scan.log",
        "security:test": "npm run test:security",
        "security:check-all": "npm run security:audit && npm run security:test 2>&1 | tee logs/security-check-all.log",
        "security:report": "node scripts/security-report.js 2>&1 | tee logs/security-report.log",
        "docs:generate": "typedoc --out docs src 2>&1 | tee logs/docs-generate.log",
        "docs:serve": "http-server docs -p 8080 -o",
        "docs:validate": "markdownlint **/*.md --ignore node_modules --ignore coverage --ignore out 2>&1 | tee logs/docs-validate.log",
        "docs:toc": "markdown-toc -i README.md 2>&1 | tee logs/docs-toc.log",
        "docs:all": "npm run docs:generate && npm run docs:validate 2>&1 | tee logs/docs-all.log",
        "docs:watch": "nodemon --watch src --ext ts --exec \"npm run docs:generate\"",
        "docs:check-links": "markdown-link-check **/*.md 2>&1 | tee logs/docs-check-links.log",
        "perf:test": "npm run test:performance",
        "perf:profile": "node --prof src/test/performance-profile.js 2>&1 | tee logs/perf-profile.log",
        "perf:analyze": "node --prof-process isolate-*.log > profile.txt 2>&1 | tee logs/perf-analyze.log",
        "perf:benchmark": "node src/test/benchmarks/run-all.js 2>&1 | tee logs/perf-benchmark.log",
        "perf:compare": "node scripts/compare-benchmarks.js 2>&1 | tee logs/perf-compare.log",
        "ci:test": "npm run test:all",
        "ci:security": "npm run security:check-all",
        "ci:quality": "npm run test:coverage && npm run docs:validate 2>&1 | tee logs/ci-quality.log",
        "ci:lint": "eslint src --ext ts --max-warnings 0 2>&1 | tee logs/ci-lint.log",
        "ci:type-check": "tsc --noEmit 2>&1 | tee logs/ci-type-check.log",
        "ci:full": "npm run ci:lint && npm run ci:type-check && npm run ci:test && npm run ci:security 2>&1 | tee logs/ci-full.log",
        "ci:deploy": "npm run ci:full && npm run deploy 2>&1 | tee logs/ci-deploy.log",
        "ci:local": "npm run ci:full",
        "maintain:clean": "node scripts/clean-artifacts.js 2>&1 | tee logs/maintain-clean.log",
        "maintain:deep-clean": "npm run maintain:clean && if exist node_modules rmdir /s /q node_modules && if exist package-lock.json del package-lock.json 2>&1 | tee logs/maintain-deep-clean.log",
        "maintain:update": "npm update && npm audit fix 2>&1 | tee logs/maintain-update.log",
        "maintain:check-deps": "npm outdated 2>&1 | tee logs/maintain-check-deps.log",
        "maintain:verify": "npm run maintain:clean && npm run dev:setup && npm run test:all 2>&1 | tee logs/maintain-verify.log",
        "maintain:reset": "npm run maintain:deep-clean && npm run dev:setup 2>&1 | tee logs/maintain-reset.log",
        "maintain:audit": "npm run security:check-all && npm run test:coverage 2>&1 | tee logs/maintain-audit.log",
        "util:check-versions": "node scripts/check-versions.js 2>&1 | tee logs/util-check-versions.log",
        "util:list-tests": "dir /s /b src\\test\\*.test.ts 2>&1 | tee logs/util-list-tests.log",
        "util:count-tests": "findstr /s /r \"test(\" src\\test\\*.ts | find /c /v \"\" 2>&1 | tee logs/util-count-tests.log",
        "util:check-todo": "findstr /s /n /r \"TODO FIXME XXX\" src\\*.ts 2>&1 | tee logs/util-check-todo.log",
        "util:size": "dir /s node_modules out 2>&1 | tee logs/util-size.log",
        "util:deps-tree": "npm list --all 2>&1 | tee logs/util-deps-tree.log",
        "util:license-check": "license-checker --summary 2>&1 | tee logs/util-license-check.log",
        "logs:view-latest": "type logs\\*.log | more",
        "logs:view": "type logs\\%npm_config_logfile%.log",
        "logs:clean": "if exist logs\\*.log del /q logs\\*.log",
        "logs:archive": "powershell Compress-Archive -Path logs\\*.log -DestinationPath logs\\archive-%date:~-4,4%%date:~-10,2%%date:~-7,2%.zip && npm run logs:clean"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^18.0.0",
        "@types/vscode": "^1.75.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "@vscode/test-electron": "^2.3.0",
        "@vscode/vsce": "^2.19.0",
        "concurrently": "^8.2.2",
        "eslint": "^8.45.0",
        "http-server": "^14.1.1",
        "license-checker": "^25.0.1",
        "markdown-link-check": "^3.11.2",
        "markdown-toc": "^1.2.0",
        "markdownlint-cli": "^0.37.0",
        "mocha": "^10.8.2",
        "nodemon": "^3.0.1",
        "nyc": "^15.1.0",
        "retire": "^3.2.0",
        "stryker-cli": "^1.0.2",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.1",
        "typedoc": "^0.25.0",
        "typedoc-plugin-markdown": "^3.17.0",
        "typescript": "^5.1.0",
        "webpack": "^5.105.2",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "axios": "^1.13.5",
        "js-yaml": "^4.1.0",
        "lucide-static": "^0.575.0",
        "vscode-languageclient": "^9.0.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/log-scout/analyzer"
    },
    "license": "MIT",
    "homepage": "https://github.com/log-scout/analyzer#readme",
    "bugs": {
        "url": "https://github.com/log-scout/analyzer/issues"
    }
}
