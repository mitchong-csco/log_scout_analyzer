{
    "name": "log-scout-analyzer",
    "displayName": "Log Scout Analyzer - DevTools Edition",
    "description": "Professional log analysis workbench with DevTools-style interface, pattern recognition, and real-time diagnostics",
    "version": "0.0.144",
    "publisher": "log-scout-team",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Linters",
        "Other"
    ],
    "keywords": [
        "log",
        "logs",
        "log-analysis",
        "diagnostics",
        "pattern-matching",
        "error-detection"
    ],
    "activationEvents": [
        "onCommand:logScoutAnalyzer.analyzeFile",
        "onCommand:logScoutAnalyzer.clearDiagnostics",
        "onCommand:logScoutAnalyzer.showPatterns",
        "onCommand:logScoutAnalyzer.showVersion",
        "onCommand:logScoutAnalyzer.openAnalyzerPanel",
        "onLanguage:log",
        "onView:scoutCategories",
        "onView:scoutResults",
        "onView:scoutFilters",
        "onView:scoutTimeline",
        "*"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "scout-analyzer",
                    "title": "Scout Analyzer",
                    "icon": "$(telescope)"
                },
                {
                    "id": "scout-inventor",
                    "title": "Scout Toolkit",
                    "icon": "$(circuit-board)"
                }
            ]
        },
        "views": {
            "scout-analyzer": [
                {
                    "id": "scoutResults",
                    "name": "Results",
                    "icon": "$(list-tree)",
                    "contextualTitle": "Scout Results",
                    "visibility": "visible"
                },
                {
                    "id": "scoutFilters",
                    "name": "Filters",
                    "icon": "$(filter)",
                    "contextualTitle": "Result Filters",
                    "visibility": "visible"
                },
                {
                    "id": "scoutCategories",
                    "name": "Categories",
                    "icon": "$(symbol-folder)",
                    "contextualTitle": "Scout Categories",
                    "visibility": "collapsed"
                },
                {
                    "id": "scoutTimeline",
                    "name": "Timeline",
                    "icon": "$(clock)",
                    "contextualTitle": "Scout Timeline",
                    "visibility": "collapsed"
                },
                {
                    "id": "scoutAnalyzer",
                    "name": "Analyzer",
                    "icon": "$(play-circle)",
                    "contextualTitle": "Scout Analyzer",
                    "visibility": "visible"
                },
                {
                    "id": "scoutCachedFiles",
                    "name": "Cached Files",
                    "icon": "$(database)",
                    "contextualTitle": "Cached Analysis Files",
                    "visibility": "visible"
                }
            ],
            "scout-inventor": [
                {
                    "id": "scoutInventor",
                    "name": "Quick Actions",
                    "icon": "$(circuit-board)",
                    "contextualTitle": "Scout Toolkit",
                    "visibility": "visible"
                }
            ]
        },
        "languages": [
            {
                "id": "log",
                "aliases": [
                    "Log File",
                    "log"
                ],
                "extensions": [
                    ".log",
                    ".txt",
                    ".out",
                    ".err"
                ],
                "filenames": [
                    "log",
                    "syslog"
                ],
                "filenamePatterns": [
                    "**/log.[0-9]*",
                    "log.{1..10}",
                    "*.log.*"
                ],
                "configuration": "./language-configuration/log.json"
            }
        ],
        "grammars": [
            {
                "language": "log",
                "scopeName": "text.log",
                "path": "./syntaxes/log.tmLanguage.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Log Scout Analyzer",
            "properties": {
                "logScoutAnalyzer.enableDiagnostics": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable diagnostic messages for log files"
                },
                "logScoutAnalyzer.patterns.errors": {
                    "type": "array",
                    "default": [
                        "(?i)(error|fail|fatal|exception|panic|crash|abort):\\s*(.+)",
                        "(?i)(stack\\s+trace|traceback):",
                        "(?i)Exception in thread",
                        "(?i)Caused by:",
                        "\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2},\\d{3}\\s+ERROR\\s+\\[.*?\\]\\s+\\[.*?\\]\\s+\\[.*?\\]\\s+\\[.*?\\]\\s+-\\s+(.+)",
                        "(?i)No Interface available",
                        "(?i)queryNetwork.*?failed",
                        "(?i)connection\\s+(failed|timeout|refused|reset)",
                        "(?i)authentication\\s+(failed|error)",
                        "(?i)certificate\\s+(error|invalid|expired)",
                        "(?i)CUCM.*?(unreachable|failed|error)",
                        "(?i)SIP.*?(error|failed)",
                        "(?i)registration\\s+failed",
                        "(?i)unable to (connect|register|authenticate)",
                        "(?i)network.*?unavailable",
                        "(?i)device not found",
                        "(?i)service.*?(unavailable|failed)",
                        "(?i)media.*?(failed|error)",
                        "(?i)call.*?failed",
                        "(?i)voicemail.*?(error|failed)"
                    ],
                    "description": "Regular expressions for error patterns"
                },
                "logScoutAnalyzer.patterns.warnings": {
                    "type": "array",
                    "default": [
                        "(?i)(warning|warn|caution):\\s*(.+)",
                        "(?i)deprecated:",
                        "(?i)(timeout|timed out)",
                        "(?i)retry",
                        "\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2},\\d{3}\\s+WARN\\s+\\[.*?\\]\\s+\\[.*?\\]\\s+\\[.*?\\]\\s+\\[.*?\\]\\s+-\\s+(.+)",
                        "(?i)retrying connection",
                        "(?i)slow response",
                        "(?i)performance degraded",
                        "(?i)high latency",
                        "(?i)packet loss",
                        "(?i)quality.*?(degraded|poor|low)",
                        "(?i)bandwidth.*?(low|insufficient)",
                        "(?i)certificate.*?expiring",
                        "(?i)token.*?expires",
                        "(?i)fallback to",
                        "(?i)switching to backup",
                        "(?i)attempting reconnect",
                        "(?i)network change detected",
                        "(?i)dns.*?timeout",
                        "(?i)TLS.*?version",
                        "(?i)cipher.*?weak"
                    ],
                    "description": "Regular expressions for warning patterns"
                },
                "logScoutAnalyzer.patterns.info": {
                    "type": "array",
                    "default": [
                        "(?i)(info|information):\\s*(.+)",
                        "(?i)(success|successful|completed):",
                        "(?i)started",
                        "(?i)initialized",
                        "\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2},\\d{3}\\s+INFO\\s+\\[.*?\\]\\s+\\[.*?\\]\\s+\\[.*?\\]\\s+\\[.*?\\]\\s+-\\s+(.+)",
                        "(?i)registration\\s+(successful|complete)",
                        "(?i)connected to CUCM",
                        "(?i)authenticated successfully",
                        "(?i)call\\s+(established|connected|completed)",
                        "(?i)service.*?(started|running|ready)",
                        "(?i)device.*?(registered|active)",
                        "(?i)user.*?(logged in|signed in)",
                        "(?i)presence.*?updated",
                        "(?i)status.*?changed",
                        "(?i)configuration.*?(loaded|updated)",
                        "(?i)certificate.*?validated",
                        "(?i)network.*?available",
                        "(?i)quality.*?(good|excellent)"
                    ],
                    "description": "Regular expressions for info patterns"
                },
                "logScoutAnalyzer.patterns.debug": {
                    "type": "array",
                    "default": [
                        "(?i)(debug|trace):\\s*(.+)",
                        "(?i)verbose:",
                        "\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2},\\d{3}\\s+DEBUG\\s+\\[.*?\\]\\s+\\[.*?\\]\\s+\\[.*?\\]\\s+\\[.*?\\]\\s+-\\s+(.+)",
                        "\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2},\\d{3}\\s+TRACE\\s+\\[.*?\\]\\s+\\[.*?\\]\\s+\\[.*?\\]\\s+\\[.*?\\]\\s+-\\s+(.+)",
                        "(?i)entering (method|function)",
                        "(?i)exiting (method|function)",
                        "(?i)parameter:",
                        "(?i)variable:",
                        "(?i)state:",
                        "(?i)step \\d+",
                        "(?i)processing:",
                        "(?i)received data",
                        "(?i)sending data",
                        "(?i)cache (hit|miss)",
                        "(?i)query executed",
                        "(?i)request received",
                        "(?i)response sent"
                    ],
                    "description": "Regular expressions for debug patterns"
                },
                "logScoutAnalyzer.maxFileSize": {
                    "type": "number",
                    "default": 10485760,
                    "description": "Maximum file size in bytes to analyze (default: 10MB)"
                },
                "logScoutAnalyzer.contextLines": {
                    "type": "number",
                    "default": 5,
                    "description": "Number of context lines to show for multi-line patterns"
                },
                "logScoutAnalyzer.autoPromptOnOpen": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show a prompt to analyze log files when they are opened"
                },
                "logScoutAnalyzer.showStatusBarButton": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show the Scout analyze button in the status bar"
                },
                "logScoutAnalyzer.showResultsPanel": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show the Results Panel when analysis is complete"
                },
                "logScoutAnalyzer.autoOpenAnalyzerPanel": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically open Scout Analyzer Panel when a log file is opened"
                },
                "logScoutAnalyzer.useEnhancedTreeView": {
                    "type": "boolean",
                    "default": true,
                    "description": "Use enhanced tree view with rich visual styling (colored icons, detailed tooltips, badges)"
                },
                "logScoutAnalyzer.highlightDuration": {
                    "type": "number",
                    "default": 2000,
                    "minimum": 500,
                    "maximum": 10000,
                    "description": "Duration in milliseconds to highlight a line when clicked from tree view (500-10000ms)"
                },
                "logScoutAnalyzer.splitView.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable split view with annotated log display"
                },
                "logScoutAnalyzer.splitView.cursorSync": {
                    "type": "boolean",
                    "default": true,
                    "description": "Synchronize cursor position between original log and annotated split view"
                },
                "logScoutAnalyzer.splitView.scrollSync": {
                    "type": "boolean",
                    "default": true,
                    "description": "Synchronize scrolling between original log and annotated split view"
                },
                "logScoutAnalyzer.splitView.selectionSync": {
                    "type": "boolean",
                    "default": true,
                    "description": "Synchronize text selection between original log and annotated split view"
                },
                "logScoutAnalyzer.splitView.highlightSync": {
                    "type": "boolean",
                    "default": true,
                    "description": "Highlight corresponding lines when hovering between original log and annotated split view"
                },
                "logScoutAnalyzer.timeline.showSignificantEvents": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show significant lifecycle events (signin, logout, calls, connections) in Timeline view instead of just errors"
                },
                "logScoutAnalyzer.timeline.intervalMinutes": {
                    "type": "number",
                    "default": 15,
                    "minimum": 1,
                    "maximum": 1440,
                    "description": "Time interval in minutes for grouping timeline events (1-1440)"
                },
                "logScoutAnalyzer.dashboard.hiddenCategories": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Categories hidden in the annotation dashboard"
                },
                "logScoutAnalyzer.dashboard.filterError": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show ERROR severity in annotation dashboard"
                },
                "logScoutAnalyzer.dashboard.filterWarning": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show WARNING severity in annotation dashboard"
                },
                "logScoutAnalyzer.dashboard.filterInfo": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show INFO severity in annotation dashboard"
                },
                "logScoutAnalyzer.dashboard.filterWarn": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show WARN severity in annotation dashboard"
                },
                "logScoutAnalyzer.dashboard.filterDebug": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show DEBUG severity in annotation dashboard"
                },
                "logScoutAnalyzer.dashboard.filterTrace": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show TRACE severity in annotation dashboard"
                },
                "logScoutAnalyzer.dashboard.filterCritical": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show CRITICAL priority in annotation dashboard"
                },
                "logScoutAnalyzer.dashboard.filterHigh": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show HIGH priority in annotation dashboard"
                },
                "logScoutAnalyzer.dashboard.filterNormal": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show NORMAL priority in annotation dashboard"
                },
                "logScoutAnalyzer.dashboard.filterLow": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show LOW priority in annotation dashboard"
                },
                "logScoutAnalyzer.dashboard.sortBy": {
                    "type": "string",
                    "enum": [
                        "time",
                        "severity",
                        "category"
                    ],
                    "default": "time",
                    "description": "Default sort order for annotations"
                }
            }
        },
        "commands": [
            {
                "command": "logScoutAnalyzer.analyzeFile",
                "title": "Scout: Analyze Current File"
            },
            {
                "command": "logScoutAnalyzer.clearDiagnostics",
                "title": "Scout: Clear Diagnostics"
            },
            {
                "command": "logScoutAnalyzer.clearCache",
                "title": "Scout: Clear Analysis Cache"
            },
            {
                "command": "logScoutAnalyzer.showCacheStats",
                "title": "Scout: Show Cache Statistics"
            },
            {
                "command": "logScoutAnalyzer.showPatterns",
                "title": "Scout: Show Configured Patterns"
            },
            {
                "command": "logScoutAnalyzer.showAbout",
                "title": "Scout: About"
            },
            {
                "command": "logScoutAnalyzer.openActionPanel",
                "title": "Scout: Open Action Panel & Scenarios",
                "icon": "$(tools)"
            },
            {
                "command": "logScoutAnalyzer.openAnnotationDashboard",
                "title": "Scout: Open Annotation Dashboard",
                "icon": "$(notebook)"
            },
            {
                "command": "logScoutAnalyzer.refreshResults",
                "title": "Scout: Refresh Results",
                "icon": "$(refresh)"
            },
            {
                "command": "logScoutAnalyzer.jumpToLine",
                "title": "Scout: Jump to Line"
            },
            {
                "command": "logScoutAnalyzer.showConsole",
                "title": "Scout: Show Console",
                "icon": "$(terminal)"
            },
            {
                "command": "logScoutAnalyzer.clearConsole",
                "title": "Scout: Clear Console"
            },
            {
                "command": "logScoutAnalyzer.groupBySeverity",
                "title": "Scout: Group by Severity",
                "icon": "$(symbol-event)"
            },
            {
                "command": "logScoutAnalyzer.groupByCategory",
                "title": "Scout: Group by Category",
                "icon": "$(symbol-folder)"
            },
            {
                "command": "logScoutAnalyzer.groupByFile",
                "title": "Scout: Group by File",
                "icon": "$(file)"
            },
            {
                "command": "logScoutAnalyzer.resetView",
                "title": "Scout: Reset View",
                "icon": "$(clear-all)"
            },
            {
                "command": "logScoutAnalyzer.exportResults",
                "title": "Scout: Export Results",
                "icon": "$(save)"
            },
            {
                "command": "logScoutAnalyzer.sortByLine",
                "title": "Scout: Sort by Line",
                "icon": "$(sort-precedence)"
            },
            {
                "command": "logScoutAnalyzer.sortBySeverity",
                "title": "Scout: Sort by Severity",
                "icon": "$(symbol-color)"
            },
            {
                "command": "logScoutAnalyzer.sortByTime",
                "title": "Scout: Sort by Time",
                "icon": "$(history)"
            },
            {
                "command": "logScoutAnalyzer.sortByFile",
                "title": "Scout: Sort by File",
                "icon": "$(file)"
            },
            {
                "command": "logScoutAnalyzer.sortByCategory",
                "title": "Scout: Sort by Category",
                "icon": "$(symbol-folder)"
            },
            {
                "command": "logScoutAnalyzer.openAnalyzerPanel",
                "title": "Scout: Open Analyzer Panel",
                "icon": "$(search)"
            },
            {
                "command": "logScoutAnalyzer.analyzeDirectory",
                "title": "Scout: Analyze Directory",
                "icon": "$(folder)"
            },
            {
                "command": "logScoutAnalyzer.analyzeAllBelow",
                "title": "Scout: Analyze Recursively",
                "icon": "$(folder-library)"
            },
            {
                "command": "logScoutAnalyzer.toggleConsoleLocation",
