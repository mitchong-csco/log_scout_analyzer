        "menus": {
            "view/title": [
                {
                    "command": "logScoutAnalyzer.refreshResults",
                    "when": "view == scoutResults",
                    "group": "navigation"
                },
                {
                    "command": "logScoutAnalyzer.groupBySeverity",
                    "when": "view == scoutResults",
                    "group": "1_grouping@1"
                },
                {
                    "command": "logScoutAnalyzer.groupByCategory",
                    "when": "view == scoutResults",
                    "group": "1_grouping@2"
                },
                {
                    "command": "logScoutAnalyzer.groupByFile",
                    "when": "view == scoutResults",
                    "group": "1_grouping@3"
                },
                {
                    "command": "logScoutAnalyzer.resetView",
                    "when": "view == scoutResults",
                    "group": "1_grouping@4"
                },
                {
                    "command": "logScoutAnalyzer.sortByLine",
                    "when": "view == scoutResults",
                    "group": "2_sorting@1"
                },
                {
                    "command": "logScoutAnalyzer.sortBySeverity",
                    "when": "view == scoutResults",
                    "group": "2_sorting@2"
                },
                {
                    "command": "logScoutAnalyzer.sortByTime",
                    "when": "view == scoutResults",
                    "group": "2_sorting@3"
                },
                {
                    "command": "logScoutAnalyzer.sortByFile",
                    "when": "view == scoutResults",
                    "group": "2_sorting@4"
                },
                {
                    "command": "logScoutAnalyzer.sortByCategory",
                    "when": "view == scoutResults",
                    "group": "2_sorting@5"
                },
                {
                    "command": "logScoutAnalyzer.exportResults",
                    "when": "view == scoutResults || view == scoutCategories || view == scoutTimeline",
                    "group": "navigation"
                },
                {
                    "command": "logScoutAnalyzer.showConsole",
                    "when": "view == scoutResults || view == scoutCategories || view == scoutTimeline",
                    "group": "navigation"
                },
                {
                    "command": "logScoutAnalyzer.toggleSignificantEvents",
                    "when": "view == scoutTimeline",
                    "group": "navigation"
                },
                {
                    "command": "logScoutAnalyzer.clearCache",
                    "when": "view == scoutCachedFiles",
                    "group": "navigation"
                },
                {
                    "command": "logScoutAnalyzer.viewCacheMetadata",
                    "when": "view == scoutCachedFiles",
                    "group": "1_metadata@1"
                },
                {
                    "command": "logScoutAnalyzer.downloadCase",
                    "when": "view == scoutCases",
                    "group": "navigation@1"
                },
                {
                    "command": "logScoutAnalyzer.importCase",
                    "when": "view == scoutCases",
                    "group": "navigation@2"
                },
                {
                    "command": "logScoutAnalyzer.refreshCases",
                    "when": "view == scoutCases",
                    "group": "navigation@3"
                }
            ],
            "view/item/context": [
                {
                    "command": "logScoutAnalyzer.jumpToLine",
                    "when": "viewItem == result",
                    "group": "1_navigation@1"
                },
                {
                    "command": "logScoutAnalyzer.showPatternForResult",
                    "when": "viewItem == result",
                    "group": "1_navigation@2"
                },
                {
                    "command": "logScoutAnalyzer.copyResultInfo",
                    "when": "viewItem == result",
                    "group": "2_copy@1"
                },
                {
                    "command": "logScoutAnalyzer.showCacheData",
                    "when": "viewItem == result",
                    "group": "3_analysis@1"
                },
                {
                    "command": "logScoutAnalyzer.openCachedFile",
                    "when": "viewItem == cachedFile",
                    "group": "1_open@1"
                },
                {
                    "command": "logScoutAnalyzer.openFileInEditor",
                    "when": "viewItem == cachedFile",
                    "group": "1_open@2"
                },
                {
                    "command": "logScoutAnalyzer.revealInExplorer",
                    "when": "viewItem == cachedFile",
                    "group": "2_explorer@1"
                },
                {
                    "command": "logScoutAnalyzer.removeCachedFile",
                    "when": "viewItem == cachedFile",
                    "group": "3_remove@1"
                },
                {
                    "command": "logScoutAnalyzer.copyFilePath",
                    "when": "viewItem == currentFile",
                    "group": "1_actions@1"
                },
                {
                    "command": "logScoutAnalyzer.openInNewWindow",
                    "when": "viewItem == currentFile",
                    "group": "1_actions@2"
                },
                {
                    "command": "logScoutAnalyzer.analyzeFile",
                    "when": "viewItem == analyzeFile",
                    "group": "1_actions@1"
                },
                {
                    "command": "logScoutAnalyzer.analyzeDirectory",
                    "when": "viewItem == analyzeDirectory",
                    "group": "1_actions@1"
                },
                {
                    "command": "logScoutAnalyzer.analyzeAllBelow",
                    "when": "viewItem == analyzeRecursive",
                    "group": "1_actions@1"
                },
                {
                    "command": "logScoutAnalyzer.clearDiagnostics",
                    "when": "viewItem == clearResults",
                    "group": "1_actions@1"
                },
                {
                    "command": "logScoutAnalyzer.exportResults",
                    "when": "viewItem == exportResults",
                    "group": "1_actions@1"
                },
                {
                    "command": "logScoutAnalyzer.showPatterns",
                    "when": "viewItem == showPatterns",
                    "group": "1_actions@1"
                },
                {
                    "command": "logScoutAnalyzer.showAbout",
                    "when": "viewItem == version",
                    "group": "1_actions@1"
                },
                {
                    "command": "logScoutAnalyzer.copyVersionInfo",
                    "when": "viewItem == version",
                    "group": "2_copy@1"
                },
                {
                    "command": "logScoutAnalyzer.openCase",
                    "when": "viewItem == case",
                    "group": "navigation@1"
                },
                {
                    "command": "logScoutAnalyzer.openCaseLogFile",
                    "when": "viewItem == logFile",
                    "group": "navigation@1"
                },
                {
                    "command": "logScoutAnalyzer.revealCaseInExplorer",
                    "when": "viewItem == case",
                    "group": "actions@1"
                },
                {
                    "command": "logScoutAnalyzer.deleteCase",
                    "when": "viewItem == case",
                    "group": "actions@2"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "echo \"Skipping build - using existing compiled code\"",
        "build": "node generate-build-info.js && npm run compile",
        "compile": "tsc -p ./ && tsc -p tsconfig.webview.json",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js",
        "version:increment": "node increment-version.js",
        "package": "npm run version:increment && npm run build && vsce package --allow-star-activation --out log-scout-analyzer.vsix",
        "postpackage": "node copy-vsix.js",
        "deploy": "npm run package && code --install-extension log-scout-analyzer.vsix"
    },
