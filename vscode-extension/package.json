            },
            {
                "command": "logScoutAnalyzer.showAbout",
                "title": "Scout: About",
                "icon": "$(info)"
            },
            {
                "command": "logScoutAnalyzer.refreshResults",
                "title": "Scout: Refresh Results",
                "icon": "$(refresh)"
            },
            {
