{
    "name": "@log-scout/tagscout-integration",
    "version": "1.0.0",
    "description": "TagScout MongoDB integration for Log Scout Analyzer - sync and leverage existing patterns from TagScout Library",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "tagscout-cli": "./dist/cli.js"
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc --watch",
        "clean": "rm -rf dist",
        "rebuild": "npm run clean && npm run build",
        "test": "jest",
        "lint": "eslint src/**/*.ts",
        "format": "prettier --write src/**/*.ts",
        "cli": "node dist/cli.js",
        "sync": "node dist/cli.js sync",
        "sync-lsp": "node dist/cli.js sync-lsp",
        "test-connection": "node dist/cli.js test",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "log-analysis",
        "log-scout",
        "tagscout",
        "mongodb",
        "pattern-matching",
        "cisco",
        "annotation",
        "log-patterns",
        "vscode-extension"
    ],
    "author": "Log Scout Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/your-org/log-scout-analyzer.git",
        "directory": "tagscout-integration"
    },
    "engines": {
        "node": ">=16.0.0",
        "npm": ">=8.0.0"
    },
    "dependencies": {
        "mongodb": "^6.3.0",
        "js-yaml": "^4.1.0"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/js-yaml": "^4.0.9",
        "@typescript-eslint/eslint-plugin": "^6.15.0",
        "@typescript-eslint/parser": "^6.15.0",
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "@types/jest": "^29.5.11",
        "ts-jest": "^29.1.1",
        "typescript": "^5.3.3",
        "prettier": "^3.1.1"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "restricted"
    }
}
