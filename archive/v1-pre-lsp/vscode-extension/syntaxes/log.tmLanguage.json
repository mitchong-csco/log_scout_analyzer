{
  "name": "Log",
  "scopeName": "text.log",
  "fileTypes": ["log", "txt"],
  "patterns": [
    {
      "include": "#timestamps"
    },
    {
      "include": "#log-levels"
    },
    {
      "include": "#errors"
    },
    {
      "include": "#warnings"
    },
    {
      "include": "#success"
    },
    {
      "include": "#urls"
    },
    {
      "include": "#ip-addresses"
    },
    {
      "include": "#file-paths"
    },
    {
      "include": "#guids"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#brackets"
    },
    {
      "include": "#key-value-pairs"
    }
  ],
  "repository": {
    "timestamps": {
      "patterns": [
        {
          "name": "constant.numeric.timestamp.log",
          "match": "\\b\\d{4}[-/]\\d{2}[-/]\\d{2}[T\\s]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:Z|[+-]\\d{2}:\\d{2})?\\b"
        },
        {
          "name": "constant.numeric.timestamp.log",
          "match": "\\b\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?\\b"
        },
        {
          "name": "constant.numeric.timestamp.log",
          "match": "\\b\\d{4}[-/]\\d{2}[-/]\\d{2}\\b"
        },
        {
          "name": "constant.numeric.timestamp.log",
          "match": "\\b(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}\\b"
        }
      ]
    },
    "log-levels": {
      "patterns": [
        {
          "name": "keyword.control.log.error",
          "match": "(?i)\\b(ERROR|FATAL|CRITICAL|SEVERE|FAIL|FAILED)\\b"
        },
        {
          "name": "keyword.control.log.warning",
          "match": "(?i)\\b(WARN|WARNING|CAUTION|DEPRECATED)\\b"
        },
        {
          "name": "keyword.control.log.info",
          "match": "(?i)\\b(INFO|INFORMATION|NOTICE)\\b"
        },
        {
          "name": "keyword.control.log.debug",
          "match": "(?i)\\b(DEBUG|TRACE|VERBOSE)\\b"
        },
        {
          "name": "keyword.control.log.success",
          "match": "(?i)\\b(SUCCESS|SUCCESSFUL|OK|PASS|PASSED|COMPLETE|COMPLETED)\\b"
        }
      ]
    },
    "errors": {
      "patterns": [
        {
          "name": "markup.deleted.log.error",
          "match": "(?i)\\b(exception|error|fail|failure|fatal|crash|abort|panic|stack\\s+trace|traceback)\\b"
        },
        {
          "name": "markup.deleted.log.error",
          "match": "\\b[A-Z][a-zA-Z0-9]*Exception\\b"
        },
        {
          "name": "markup.deleted.log.error",
          "match": "\\b[A-Z][a-zA-Z0-9]*Error\\b"
        },
        {
          "name": "markup.deleted.log.error",
          "match": "(?i)\\bcaused\\s+by:\\s*"
        }
      ]
    },
    "warnings": {
      "patterns": [
        {
          "name": "markup.changed.log.warning",
          "match": "(?i)\\b(timeout|timed\\s+out|retry|retrying|deprecated|skipped|ignored)\\b"
        }
      ]
    },
    "success": {
      "patterns": [
        {
          "name": "markup.inserted.log.success",
          "match": "(?i)\\b(started|starting|initialized|initializing|connected|connecting|loaded|loading)\\b"
        }
      ]
    },
    "urls": {
      "patterns": [
        {
          "name": "string.other.link.log",
          "match": "\\b(?:https?|ftp|file)://[^\\s)>\"']+"
        }
      ]
    },
    "ip-addresses": {
      "patterns": [
        {
          "name": "constant.numeric.ip-address.log",
          "match": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b"
        },
        {
          "name": "constant.numeric.ip-address.log",
          "match": "\\b(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}\\b"
        }
      ]
    },
    "file-paths": {
      "patterns": [
        {
          "name": "string.other.filepath.log",
          "match": "(?:[A-Z]:|/)(?:/[^/\\s:*?\"<>|]+)+"
        },
        {
          "name": "string.other.filepath.log",
          "match": "\\b\\w+\\.(?:java|py|js|ts|cpp|c|h|cs|rb|go|rs|php|html|css|json|xml|yaml|yml|toml|md|txt|log)\\b"
        }
      ]
    },
    "guids": {
      "patterns": [
        {
          "name": "constant.numeric.guid.log",
          "match": "\\b[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.log",
          "match": "\\b-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.hex.log",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.log",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.log",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.log",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.log",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "name": "punctuation.bracket.log",
          "match": "[\\[\\]{}()]"
        }
      ]
    },
    "key-value-pairs": {
      "patterns": [
        {
          "name": "variable.other.key.log",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*[:=])"
        }
      ]
    }
  }
}
